{
	"appId": "com.senguntharinbusiness.app",
	"appName": "SIBapp",
	"webDir": "dist",
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"CapacitorCookies": {
			"enabled": true
		},
		"FirebaseMessaging": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"ContactsPlugin",
		"FirebaseMessagingPlugin",
		"AppPlugin",
		"CAPCameraPlugin",
		"FilesystemPlugin",
		"KeyboardPlugin",
		"PreferencesPlugin",
		"SharePlugin",
		"NativeBiometricPlugin"
	]
}
